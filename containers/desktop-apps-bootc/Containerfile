# Standalone bootable variant of ../desktop-apps: the same openbox + picom +
# Brave kiosk session, but as the OS itself (built on Fedora bootc) rather
# than a container run on top of Panthera via podman/container_apps. Build
# with bootc-image-builder to get a flashable .raw disk - see README.md.
#
# "The OS is in userland" here just means this is a stock Fedora bootc base
# with a kiosk session layered on as ordinary RPM packages + a systemd unit
# - no custom kernel, no custom rootfs build, nothing Buildroot-specific.
#
# Structured for Bootc Studio (github.com/theskysanctum/bootc-studio): the
# four >>>/<<< marked blocks below are read and rewritten wholesale by its
# Packages tab, so open this directory there to add/remove dnf packages,
# COPR repos, Flatpaks or AppMan apps without hand-editing this file -
# everything outside those blocks (this comment, the brave repo bootstrap,
# the user/systemd setup below) is left untouched either way.
FROM quay.io/fedora/fedora-bootc:42

ARG KIOSK_CMD="/usr/bin/brave-browser --kiosk https://example.com"

# Brave's own repo, since Fedora doesn't package it - not a COPR, so this
# can't live in the copr-repos block below; it has to run before the
# dnf-packages block instead, since that's what actually installs
# brave-browser from it.
RUN <<EOF
curl -fsSL https://brave-browser-rpm-release.s3.brave.com/brave-core.asc \
    -o /etc/pki/rpm-gpg/RPM-GPG-KEY-brave-core
cat > /etc/yum.repos.d/brave-browser.repo <<REPO
[brave-browser]
name=Brave Browser
baseurl=https://brave-browser-rpm-release.s3.brave.com/x86_64/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-brave-core
REPO
EOF

# >>> bootc-studio:copr-repos >>>
# (no COPR repos enabled yet - add some from the Packages tab)
# <<< bootc-studio:copr-repos <<<

# >>> bootc-studio:dnf-packages >>>
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked dnf install -y --setopt=keepcache=1 \
    brave-browser \
    liberation-fonts \
    mesa-dri-drivers \
    mesa-vulkan-drivers \
    openbox \
    picom \
    pipewire-pulseaudio \
    sudo \
    xorg-x11-server-Xorg \
    xorg-x11-xauth \
    xorg-x11-xinit \
    xrandr
# <<< bootc-studio:dnf-packages <<<

# >>> bootc-studio:flatpak-apps >>>
# (Flatpak/Flathub support not enabled - use the Packages tab)
# <<< bootc-studio:flatpak-apps <<<

# >>> bootc-studio:appman-apps >>>
# (AppMan/AM support not enabled - use the Packages tab)
# <<< bootc-studio:appman-apps <<<

# Chromium (and GUI apps generally) refuse their own sandbox when running
# as root, so the kiosk session runs as a real non-root user rather than
# working around that with --no-sandbox. Group membership covers the
# hardware this image itself installed drivers for (DRM/render, audio,
# input) - unlike container_apps's dynamic /dev-GID matching, there's no
# host to match against here, this image IS the whole OS.
#
# video/audio/input/render are sysusers.d-declared but not yet
# materialized into /etc/group at build time (Fedora synthesizes them
# virtually via nss-systemd until systemd-sysusers actually runs for real
# at boot), so `usermod -aG` silently no-ops here - it resolves the group
# via NSS, sees it "already exists," and never writes a real, editable
# line. Appending the real line ourselves (same name+GID as the declared
# one) sidesteps that; `files` is checked first in nsswitch.conf and
# merges cleanly with the synthesized entry rather than conflicting with
# it. GIDs are read from the sysusers.d declaration itself rather than
# hardcoded, so this doesn't silently drift if a future base image
# renumbers them.
RUN useradd -m -s /bin/bash kiosk && \
    for g in video audio input render; do \
        gid=$(grep -hoP "^g $g \K[0-9]+" /usr/lib/sysusers.d/*.conf | head -1); \
        echo "$g:x:$gid:kiosk" >> /etc/group; \
    done

# Separate admin login for console/SSH access to manage the appliance -
# the kiosk session itself has no sudo and can't reach root. NOPASSWD
# since there's no secret to bake into the image; lock it down with a
# real password or SSH key once this is actually deployed somewhere.
RUN useradd -m -s /bin/bash admin && \
    usermod -aG wheel admin && \
    echo 'admin ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/admin && \
    chmod 0440 /etc/sudoers.d/admin

COPY --chmod=0755 xinitrc /etc/kiosk/xinitrc
COPY picom.conf /etc/kiosk/picom.conf
COPY kiosk.service /usr/lib/systemd/system/kiosk.service

RUN sed -i "s|@KIOSK_CMD@|${KIOSK_CMD}|" /etc/kiosk/xinitrc && \
    systemctl enable kiosk.service && \
    systemctl set-default multi-user.target

# kiosk.service's User=/PAMName=login combo gives it a full unconfined_t
# login-session context (needed for the logind session that makes
# TTYPath/startx work at all), and SELinux's targeted policy doesn't allow
# that context to enter startx's initrc_exec_t label as an entrypoint -
# confirmed by booting this image: startx got killed outright with an AVC
# denial before the kiosk session ever started. Same "not a security
# boundary, single-purpose appliance" call as container_apps/desktop-apps
# - permissive rather than chasing every AVC denial Chromium's sandboxing
# and X's own privilege transitions are likely to keep tripping.
RUN sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config
