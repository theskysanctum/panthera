#!/bin/bash

export XDG_BIN_HOME=/userdata/saves/appman/bin
export XDG_DATA_HOME=/userdata/saves/appman/share
export XDG_CONFIG_HOME=/userdata/saves/appman/config
export XDG_CACHE_HOME=/userdata/saves/appman/cache

es_add_game_begin() {
    echo "<gameList>" > /tmp/batocera-appman-update.tmp || return 1
}

es_add_game_end() {
    ES_SERVER="http://127.0.0.1:1234"

    echo "</gameList>" >> /tmp/batocera-appman-update.tmp || return 1
    curl -s -X POST -H "Content-type: application/x-www-form-urlencoded" -H "Accept: text/plain" "${ES_SERVER}/addgames/appman" -d "@/tmp/batocera-appman-update.tmp" > /dev/null || return 1
}

es_add_game() {
    GAME_BASENAME=$1
    GAME_NAME=$2
    GAME_IMAGE=$3

    (cat <<EOF
<game>
  <path>./${GAME_BASENAME}</path>
  <name>${GAME_NAME}</name>
  <desc></desc>
  <rating></rating>
  <releasedate></releasedate>
  <developer></developer>
  <publisher></publisher>
  <genre></genre>
  <players></players>
  <image>${GAME_IMAGE}</image>
  <manual></manual>
  <video></video>
</game>
EOF
) >> /tmp/batocera-appman-update.tmp || return 1
}

mkdir -p /userdata/roms/appman/images || exit 1
mkdir -p "${XDG_DATA_HOME}/applications" || exit 1

# create the applications
find "${XDG_DATA_HOME}/applications" -maxdepth 1 -name "*-AM.desktop" -print0 2>/dev/null | (
    es_add_game_begin || exit 1
    N=0
    while IFS= read -r -d '' DESKTOP
    do
	PROGRAM=$(basename "${DESKTOP}" -AM.desktop)
	APPPATH="/userdata/roms/appman/${PROGRAM}.appman"

	if ! test -e "${APPPATH}"
	then
	    NAME=$(grep -m1 -E '^Name=' "${DESKTOP}" | sed -e 's/^Name=//')
	    test -z "${NAME}" && NAME="${PROGRAM}"

	    ICON=$(grep -m1 -E '^Icon=' "${DESKTOP}" | sed -e 's/^Icon=//')
	    IMGARG=
	    if test -n "${ICON}" && test -e "${ICON}"
	    then
		IMGARG="./images/${PROGRAM}.png"
		cp "${ICON}" "/userdata/roms/appman/${IMGARG}" || exit 1
	    fi

	    echo "adding ${PROGRAM}"
	    echo "${PROGRAM}" > "${APPPATH}"

	    # add game in es
	    if ! es_add_game "${PROGRAM}.appman" "${NAME}" "${IMGARG}"
	    then
		echo "adding game in es failed" >&2
		exit 1
	    fi

	    let N++
	fi
    done
    test ${N} -gt 0 && es_add_game_end
)
exit 0
