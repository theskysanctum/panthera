"""A simple full-screen list picker for a mounted disc's content: browses what's on it the same
way an automatic install would classify it - a single game (an .m3u if there's exactly one,
otherwise the one unambiguous rom file next to play.txt), or a folder of further entries to open
- and lets you pick exactly what to install when a disc has more than one game on it. Self-
contained on purpose (no sibling modules) - the same shape every other rom under roms/pygame/
already uses.

Controls: Up/Down to move, Enter/A to select, Backspace/B to go up a folder or cancel.
"""
import re
import shutil
import subprocess
import sys
from pathlib import Path

import pygame

RELOAD_GAMES_CMD = (
    "sh -c 'for i in $(seq 1 60); do "
    "IS_IDLE=$(curl -s --connect-timeout 1 http://127.0.0.1:1234/isIdle); "
    "echo \"$IS_IDLE\" | grep -q true && { curl -s http://127.0.0.1:1234/reloadgames >/dev/null; break; }; "
    "sleep 1; done'"
)

DEVICE_NODE = "/dev/sr0"
MOUNTPOINT = Path("/userdata/system/.disc-mount")
PLAY_FILE = "play.txt"
IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp")
ROMS_ROOT = Path("/userdata/roms")

BG = (20, 20, 24)
FG = (235, 235, 235)
DIM = (140, 140, 150)
SEL_BG = (60, 90, 170)


# -- disc content classification -----------------------------------------------------------

def mount_disc():
    result = subprocess.run(["findmnt", "--noheadings", "--output", "SOURCE", str(MOUNTPOINT)], capture_output=True, text=True)
    if result.stdout.strip():
        return MOUNTPOINT
    MOUNTPOINT.mkdir(parents=True, exist_ok=True)
    try:
        subprocess.run(["mount", "-o", "ro", DEVICE_NODE, str(MOUNTPOINT)], check=True, capture_output=True)
        return MOUNTPOINT
    except subprocess.CalledProcessError:
        return None


def read_play_file(folder):
    path = folder / PLAY_FILE
    if not path.is_file():
        return None
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.split("#", 1)[0].strip()
            if line:
                return line
    except OSError:
        return None
    return None


def find_rom(folder):
    m3u_files = sorted(folder.glob("*.m3u"))
    if len(m3u_files) == 1:
        return m3u_files[0]
    if len(m3u_files) > 1:
        return None
    candidates = [p for p in sorted(folder.iterdir()) if p.is_file() and p.name != PLAY_FILE]
    images = [p for p in candidates if p.suffix.lower() in IMAGE_EXTS]
    if len(images) == 1:
        candidates = [p for p in candidates if p not in images]
    roms = [p for p in candidates if p.suffix.lower() not in IMAGE_EXTS] or candidates
    if len(roms) != 1:
        return None
    return roms[0]


class Entry:
    def __init__(self, kind, name, path, system=None, rom=None):
        self.kind = kind
        self.name = name
        self.path = path
        self.system = system
        self.rom = rom


def browse(folder):
    try:
        if not folder.is_dir():
            return []
        system = read_play_file(folder)
        if system is not None:
            rom = find_rom(folder)
            if rom is None:
                return []
            return [Entry("game", folder.name or system, folder, system=system, rom=rom)]
        return [Entry("folder", p.name, p) for p in sorted(folder.iterdir()) if p.is_dir()]
    except OSError:
        return []


def sanitize(name):
    return re.sub(r"[^A-Za-z0-9._ -]+", "_", name).strip() or "game"


def install_game(entry):
    dest_roms_dir = ROMS_ROOT / entry.system
    dest_roms_dir.mkdir(parents=True, exist_ok=True)
    try:
        if entry.rom.suffix.lower() == ".m3u":
            dest_dir = dest_roms_dir / sanitize(entry.name)
            if dest_dir.exists():
                return False, f"{entry.name} is already installed"
            dest_dir.mkdir(parents=True)
            discs = [line.split("#", 1)[0].strip() for line in entry.rom.read_text(encoding="utf-8", errors="replace").splitlines()]
            for rel in [d for d in discs if d]:
                shutil.copy2(entry.rom.parent / rel, dest_dir)
            shutil.copy2(entry.rom, dest_dir)
            return True, f"Installed {entry.name}"
        dest_file = dest_roms_dir / entry.rom.name
        if dest_file.exists():
            return False, f"{entry.name} is already installed"
        shutil.copy2(entry.rom, dest_roms_dir)
        return True, f"Installed {entry.name}"
    except OSError as e:
        return False, f"Couldn't install {entry.name}: {e}"


# -- UI -------------------------------------------------------------------------------------

class Picker:
    def __init__(self, screen, font):
        self.screen = screen
        self.font = font
        self.folder_stack = []  # breadcrumb of parent folders, for Backspace
        self.folder = MOUNTPOINT
        self.entries = []
        self.selected = 0
        self.status = ""
        self.mode = "list"  # "list" | "actions"
        self.action_entry = None
        self.action_index = 0
        self.installed_anything = False
        self.refresh()

    def refresh(self):
        self.entries = browse(self.folder)
        self.selected = 0
        if not self.entries:
            self.status = "Nothing playable here." if self.folder_stack else "No disc detected, or nothing playable on it."

    def open_selected(self):
        if not self.entries:
            return
        entry = self.entries[self.selected]
        if entry.kind == "folder":
            self.folder_stack.append(self.folder)
            self.folder = entry.path
            self.refresh()
        else:
            self.mode = "actions"
            self.action_entry = entry
            self.action_index = 0

    def go_back(self):
        if self.mode == "actions":
            self.mode = "list"
            return True
        if self.folder_stack:
            self.folder = self.folder_stack.pop()
            self.refresh()
            return True
        return False

    def do_action(self):
        actions = ["Install", "Cancel"]
        choice = actions[self.action_index]
        if choice == "Install":
            ok, message = install_game(self.action_entry)
            self.status = message
            self.installed_anything = self.installed_anything or ok
        self.mode = "list"
        self.refresh()

    def handle_key(self, key):
        if self.mode == "actions":
            if key in (pygame.K_UP, pygame.K_DOWN):
                self.action_index = 1 - self.action_index
            elif key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                self.do_action()
            elif key in (pygame.K_BACKSPACE, pygame.K_ESCAPE):
                self.go_back()
            return
        if key == pygame.K_UP and self.entries:
            self.selected = (self.selected - 1) % len(self.entries)
        elif key == pygame.K_DOWN and self.entries:
            self.selected = (self.selected + 1) % len(self.entries)
        elif key in (pygame.K_RETURN, pygame.K_KP_ENTER):
            self.open_selected()
        elif key in (pygame.K_BACKSPACE, pygame.K_ESCAPE):
            self.go_back()

    def draw(self):
        self.screen.fill(BG)
        title = "Play Disc" if not self.folder_stack else self.folder.name
        self.screen.blit(self.font.render(title, True, FG), (40, 30))

        if self.mode == "actions":
            for i, label in enumerate(["Install", "Cancel"]):
                color = SEL_BG if i == self.action_index else BG
                rect = pygame.Rect(40, 100 + i * 50, 300, 40)
                pygame.draw.rect(self.screen, color, rect)
                self.screen.blit(self.font.render(label, True, FG), (rect.x + 10, rect.y + 8))
        else:
            for i, entry in enumerate(self.entries):
                color = SEL_BG if i == self.selected else BG
                rect = pygame.Rect(40, 90 + i * 44, self.screen.get_width() - 80, 38)
                pygame.draw.rect(self.screen, color, rect)
                label = entry.name + ("/" if entry.kind == "folder" else "")
                self.screen.blit(self.font.render(label, True, FG), (rect.x + 10, rect.y + 6))

        if self.status:
            self.screen.blit(self.font.render(self.status, True, DIM), (40, self.screen.get_height() - 60))
        pygame.display.flip()


def main():
    pygame.init()
    screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
    pygame.mouse.set_visible(False)
    font = pygame.font.Font(None, 32)

    mount_disc()
    picker = Picker(screen, font)

    clock = pygame.time.Clock()
    running = True
    while running:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE and picker.mode == "list" and not picker.folder_stack:
                    running = False
                else:
                    picker.handle_key(event.key)
        picker.draw()
        clock.tick(30)

    if picker.installed_anything:
        # ES is still suspended waiting on this process to exit; backgrounded so this doesn't
        # block that exit, and it polls /isIdle itself since ES only accepts /reloadgames again
        # once it's actually idle (right after it resumes).
        subprocess.Popen(RELOAD_GAMES_CMD, shell=True, start_new_session=True)


if __name__ == "__main__":
    main()
