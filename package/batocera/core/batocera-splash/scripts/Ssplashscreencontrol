#!/bin/sh
# Splash Screen Control
# This service controls length of picture displayed during startup
# by cyperghost aka lala on discord

splash_stop ()
{
    start-stop-daemon -K -q -p /var/run/user-splash-image.pid
    rm -f /var/run/user-splash-image.pid
}

#### MAIN ####

ARCH=$(cat /usr/share/batocera/batocera.arch)

case $1 in
    start)
        # Is service active?
        if [ ! -f "/var/run/user-splash-image.pid" ]; then
            echo "$0: No image service found!" >&2
            exit 0
        fi

        # Read Config and set some defaults
        splash_setting="$(/usr/bin/batocera-settings-get splash.screen.length)"
        [ -z "$splash_setting" ] && splash_setting=auto
        [ "$splash_setting" = "auto" -a "$(echo $ARCH | cut -c 1-3)" = "rpi" -a "$(echo $ARCH | cut -c 1-3)" = "bcm" ] && splash_setting=$ARCH
        case "$splash_setting" in
            auto|bcm2835|bcm2836|bcm2837|bcm2711)
                # Keep the image up until emulationstation is ready, but not more than 20 seconds
                count=0
                while [ ! -f "/tmp/emulationstation.ready" -a $count -lt 20 ]
                do
                    sleep 1
                    count=$((count+1))
                done
                splash_stop
            ;;
            [0-90]*)
                # Stop as set. 10s max for images.
                sleeptimer=$(echo "$splash_setting" | grep -Eo [0-9] | tr -d "\n")
                [ $sleeptimer -gt 10 ] && sleeptimer=10
                sleep $sleeptimer
                splash_stop
            ;;
            fastboot|*)
                # fastboot or invalid settings
                #
                splash_stop
            ;;
        esac
    ;;
    stop)
    ;;
    *)
        echo "Usage $0 {start|stop}"
esac
exit 0
